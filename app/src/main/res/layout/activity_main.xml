<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_activity_root" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="fill_parent" android:layout_height="fill_parent" android:background="@drawable/telainicial">

    <!-- Campo de nickname (nome_sobrenome) -->
    <EditText
        android:id="@+id/edit_text_name"
        android:layout_width="188dp"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/edit_text_dark_rounded"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:hint="seu_nome"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:textSize="12sp"
        android:singleLine="true"
        android:maxLength="28"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botões de redes sociais (canto inferior esquerdo) -->
    <LinearLayout
        android:id="@+id/social_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/button_discord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/discord_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Discord em desenvolvimento" />

        <ImageButton
            android:id="@+id/button_instagram"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/insta_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Instagram em desenvolvimento" />

        <ImageButton
            android:id="@+id/button_youtube"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/yt_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="YouTube em desenvolvimento" />

    </LinearLayout>

    <TextView
        android:id="@+id/server_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="● VERIFICANDO SERVIDOR"
        android:textColor="#FFD8A000"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/button_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_play"
        android:layout_width="178dp"
        android:layout_height="48dp"
        android:layout_margin="22dp"
        android:background="@drawable/launcher_action_button"
        android:drawableStart="@drawable/launcher_update_small"
        android:drawablePadding="7dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="ATUALIZAR"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@drawable/progressbar_custom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <!-- Loading modal: permanece acima de tudo e some antes da etapa de login. -->
    <FrameLayout
        android:id="@+id/launcher_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/launcher_loading_background"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:translationZ="100dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/launcher_loading_logo"
            android:layout_width="76dp"
            android:layout_height="70dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/nexion_logo" />

        <TextView
            android:id="@+id/launcher_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Carregando o jogo"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/launcher_loading_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="58dp"
            android:layout_marginBottom="45dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/loading_progress_bar" />

        <TextView
            android:id="@+id/launcher_loading_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Eu já li e concordo com os Termos e Política de Privacidade"
            android:textColor="#D9DDE4"
            android:textSize="6sp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
